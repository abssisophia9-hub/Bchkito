# --- Device / UX ---
BCHKITO_DEFAULT_CITY=Ifrane
BCHKITO_SECOND_CITY=
BCHKITO_DAUGHTER_NAME=بنتي
BCHKITO_DAUGHTER_WA_PHONE=+212600000000
BCHKITO_PTT_MODE=keyboard
BCHKITO_PTT_GPIO_PIN=17
BCHKITO_SAMPLE_RATE=16000
BCHKITO_LOG_LEVEL=INFO
BCHKITO_LOG_DIR=logs

# --- Local STT (faster-whisper) ---
BCHKITO_WHISPER_MODEL=small
BCHKITO_WHISPER_DEVICE=cpu
BCHKITO_WHISPER_COMPUTE_TYPE=int8
BCHKITO_WHISPER_LANGUAGE=ar
BCHKITO_WHISPER_INITIAL_PROMPT=مرحبا، الجو فإفران، الأخبار، بنتي، واتساب، صباح الخير

# --- Local LLM (Ollama) ---
BCHKITO_OLLAMA_HOST=http://127.0.0.1:11434
BCHKITO_OLLAMA_MODEL=qwen2.5:3b
BCHKITO_LLM_TIMEOUT_SECONDS=45

# --- Cloud LLM (Groq or Together; leave empty to stay local-only) ---
BCHKITO_CLOUD_LLM_PROVIDER=groq
BCHKITO_GROQ_API_KEY=
BCHKITO_GROQ_MODEL=llama-3.3-70b-versatile
BCHKITO_TOGETHER_API_KEY=
BCHKITO_TOGETHER_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo

# --- TTS tiers ---
# local | azure | elevenlabs
BCHKITO_TTS_DEFAULT_TIER=local
BCHKITO_PIPER_BINARY=piper
BCHKITO_PIPER_MODEL_PATH=models/piper/ar_JO-kareem-medium.onnx
BCHKITO_PIPER_SPEAKER=0
BCHKITO_ESPEAK_VOICE=ar
BCHKITO_AZURE_SPEECH_KEY=
BCHKITO_AZURE_SPEECH_REGION=westeurope
BCHKITO_AZURE_SPEECH_VOICE=ar-EG-SalmaNeural
BCHKITO_ELEVENLABS_API_KEY=
BCHKITO_ELEVENLABS_VOICE_ID=

# --- OpenWeatherMap ---
BCHKITO_OPENWEATHER_API_KEY=
BCHKITO_OPENWEATHER_UNITS=metric
BCHKITO_WEATHER_COLD_C=12
BCHKITO_WEATHER_HOT_C=30
BCHKITO_WEATHER_WIND_MS=8

# --- RSS / cache ---
BCHKITO_RSS_FEEDS=https://www.hespress.com/feed,https://www.medi1tv.com/ar/rss,https://www.yabiladi.com/rss/news.xml
BCHKITO_NEWS_CACHE_MINUTES=20
BCHKITO_CACHE_DIR=data/cache

# --- WhatsApp Cloud API ---
BCHKITO_WHATSAPP_TOKEN=
BCHKITO_WHATSAPP_PHONE_NUMBER_ID=
BCHKITO_WHATSAPP_API_VERSION=v21.0
BCHKITO_WHATSAPP_DEFAULT_MODE=text
